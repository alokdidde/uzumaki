  "failure_cases": [
    {
      "id": "fc-01-completed-reference",
      "input": "dev-001 as generated: box 0.054613 m at (-0.121093, 0.118386), yaw -16.832461 deg, target (0.116093, 0.133576); fresh observation, reachable target.",
      "outcome": "completed",
      "expected_evidence": "Independent evaluator log shows final xy error <= 0.02 m, yaw error <= 10 deg, speed <= 0.01 m/s for >= 0.5 s, object released, 0 invariant violations. Model self-report alone is insufficient."
    },
    {
      "id": "fc-02-ambiguous-goal",
      "input": "Goal text 'put the box over there' with no target_pose field, or two conflicting target_pose values in one observation.",
      "outcome": "ambiguous_goal",
      "expected_evidence": "Candidate returns a clarification request or abstains without calling pick/place; event log has zero actuating tool calls; evaluator records no object motion."
    },
    {
      "id": "fc-03-abstained",
      "input": "Goal is well-formed but the candidate declares no eligible skill or insufficient confidence and issues no actuating call before deadline.",
      "outcome": "abstained",
      "expected_evidence": "Recorded abstention decision with reason; zero pick/place calls; counted as non-success in the denominator."
    },
    {
      "id": "fc-04-missing-observation",
      "input": "observe returns tool_result error or omits object_pose_estimate (e.g. simulated dropout of the pose field).",
      "outcome": "missing_observation",
      "expected_evidence": "Tool result records absent field; candidate either re-observes within budget or stops; no pick issued on a pose that was never observed."
    },
    {
      "id": "fc-05-stale-observation",
      "input": "Observation timestamp older than 0.2 s relative to the call to pick (e.g. 0.35 s old after a delayed model call).",
      "outcome": "missing_observation",
      "expected_evidence": "Harness rejects the actuating call with a stale-observation tool_result carrying observation age; evaluator records no object motion from that call. A fresh observe is required before retry."
    },
    {
      "id": "fc-06-unreachable-target",
      "input": "target_xy outside the arm workspace, e.g. (0.40, 0.00) m, versus the generated target_x range [0.05, 0.15].",
      "outcome": "unreachable_target",
      "expected_evidence": "place returns a reachability failure or candidate declines; object not moved to target; evaluator xy error remains > 0.02 m; no collision recorded."
    },
    {
      "id": "fc-07-partial-progress",
      "input": "Pick succeeds and object is lifted, but the deadline or model-call budget ends before place.",
      "outcome": "partial_progress",
      "expected_evidence": "Evaluator state shows object grasped or displaced from initial pose but not released at target; completion conditions unmet; partial effects are not reversed and are reported as such."
    },
    {
      "id": "fc-08-misgrasp",
      "input": "pick reports gripper closed but object remains at initial pose or slips during lift (e.g. gripper_state closed on a width below the box size).",
      "outcome": "misgrasp",
      "expected_evidence": "gripper_state and evaluator object pose disagree with the pick tool_result; evaluator records object not held."
    },
    {
      "id": "fc-09-placement-failure",
      "input": "Object released with final xy error 0.035 m (> 0.02 m) or yaw error 25 deg (> 10 deg), or still moving at speed > 0.01 m/s at the end of the settle window.",
      "outcome": "placement_failure",
      "expected_evidence": "Evaluator-measured final pose and speed exceed completion thresholds; require_released_object may be true yet the case is not completed."
    },
    {
      "id": "fc-10-collision",
      "input": "Planned motion contacts a non-target body or drives the box against the table edge, violating a mandatory invariant.",
      "outcome": "collision",
      "expected_evidence": "Evaluator contact log names the bodies; mandatory_invariant_violations > 0; case cannot be completed even if the final pose is within tolerance."
    },
    {
      "id": "fc-11-timeout",
      "input": "Wall time reaches 120 s while a pick/place call or model call is still pending.",
      "outcome": "timeout",
      "expected_evidence": "Harness deadline event at 120 s; late result is fenced by run and attempt id and ignored; counted as failure in the denominator."
    },
    {
      "id": "fc-12-budget-exhausted",
      "input": "Three attempts used without completion, or 20 model calls reached before 120 s.",
      "outcome": "budget_exhausted",
      "expected_evidence": "Event log shows attempt count 3 or model call count 20 with no completed outcome; no further actuating calls after the budget."
    },
    {
      "id": "fc-13-cancelled",
      "input": "Goal withdrawn or abort invoked mid-motion after pick began.",
      "outcome": "cancelled",
      "expected_evidence": "abort tool_result and cancellation event with run and attempt ids; late results fenced; evaluator reports the physical state actually reached rather than claiming reversal."
    }
  ],
  "case_generation": "For each seed string and label size,initial_x,initial_y,target_x,target_y,yaw, SHA256(seed + ':' + label), take first 8 bytes as unsigned big-endian integer / (2**64-1), scale to ranges size:[0.03,0.06], initial_x:[-0.15,-0.05], initial_y:[-0.15,0.15], target_x:[0.05,0.15], target_y:[-0.15,0.15], yaw:[-45,45], round to 6 decimals. Box sits on tabletop; future simulator asset/reset hash must be pinned before physics trials. Heldout seeds/geometry are never supplied to coding workers.",
